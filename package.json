{
  "name": "@axhy/shared",
  "version": "1.12.0",
  "description": "Shared state machines, types, and utilities for axhy-admin and axhy-v2-b2b",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./state-machines/*": {
      "types": "./dist/state-machines/*.d.ts",
      "default": "./dist/state-machines/*.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./ai/tools": {
      "types": "./dist/ai/tools.d.ts",
      "default": "./dist/ai/tools.js"
    },
    "./ai/prompt": {
      "types": "./dist/ai/prompt.d.ts",
      "default": "./dist/ai/prompt.js"
    }
  },
  "files": [
    "dist",
    "src",
    "prisma"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js",
    "prepare": "tsc"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@types/node": "^22.19.17",
    "typescript": "^5.6.0"
  },
  "private": true
}
